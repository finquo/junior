{
	"name": "app",
	"private": true,
	"workspaces": {
		"packages": [
			"frontend",
			"backend",
			"packages/*"
		],
		"catalog": {
			"@orpc/client": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/server": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"@types/node": "^26.4.1",
			"better-auth": "1.7.5",
			"typescript": "^6.0.3",
			"varlock": "1.18.0",
			"zod": "^4.5.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "vp run -r dev",
		"build": "vp run -r build",
		"check-types": "vp run -r check-types",
		"check": "biome check --write .",
		"lint": "vp lint",
		"format": "vp fmt",
		"staged": "vp staged",
		"hooks:setup": "vp config",
		"dev:web": "vp run --filter web dev",
		"dev:server": "vp run --filter server dev",
		"db:push": "vp run --filter @app/db db:push",
		"db:studio": "vp run --filter @app/db db:studio",
		"db:generate": "vp run --filter @app/db db:generate",
		"db:migrate": "vp run --filter @app/db db:migrate",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "catalog:",
		"rolldown": "1.2.7",
		"typescript": "catalog:",
		"varlock": "catalog:",
		"vite-plus": "0.3.1"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
	},
	"packageManager": "bun@1.4.1"
}
