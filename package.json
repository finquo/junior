{
	"name": "app",
	"type": "module",
	"private": true,
	"workspaces": {
		"packages": [
			"frontend",
			"backend",
			"packages/*"
		],
		"catalog": {
			"@orpc/client": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/server": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"@types/node": "^26.4.1",
			"better-auth": "1.7.5",
			"typescript": "^6.0.3",
			"varlock": "1.21.0",
			"wrangler": "^4.139.0",
			"zod": "^4.5.4"
		}
	},
	"scripts": {
		"frontend": "vp run --filter frontend",
		"backend": "vp run --filter backend",
		"dev": "vp run -r dev",
		"build": "vp run -r build",
		"check-types": "vp run -r check-types",
		"check": "biome check --write .",
		"lint": "vp lint",
		"format": "vp fmt",
		"staged": "vp staged",
		"hooks:setup": "vp config",
		"env:generate": "vp run -r env:generate"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "catalog:",
		"@varlock/cloudflare-integration": "^1.6.0",
		"rolldown": "1.2.7",
		"typescript": "catalog:",
		"varlock": "catalog:",
		"vite-plus": "0.3.1"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
	},
	"packageManager": "bun@1.4.1"
}
