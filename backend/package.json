{
	"name": "backend",
	"type": "module",
	"scripts": {
		"cf:dev": "wrangler dev --port 3000",
		"compile": "varlock codegen && tsdown",
		"construct": "varlock codegen && tsdown",
		"build": "varlock codegen && tsdown",
		"check": "tsc --noEmit",
		"format": "biome format ./ --write",
		"dev": "bun run --env-file=../.env --hot src/index.ts --port 3000",
		"start": "node out/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "auth generate --config src/services.ts --output src/db/auth.test.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"varlock": {
		"loadPath": [
			"./",
			"../"
		]
	},
	"exports": {
		".": {
			"import": "./out/index.mjs",
			"types": "./out/index.d.mts",
			"default": "./out/index.mjs"
		},
		"./config": {
			"import": "./dist/config/index.mjs",
			"types": "./dist/config/index.d.mts",
			"default": "./dist/config/index.mjs"
		},
		"./auth": {
			"import": "./dist/auth/export.mjs",
			"types": "./dist/auth/export.d.mts",
			"default": "./dist/auth/export.mjs"
		},
		"./db": {
			"import": "./dist/db/export.mjs",
			"types": "./dist/db/export.d.mts",
			"default": "./dist/db/export.mjs"
		},
		"./api": {
			"types": "./dist/api/index.d.mts",
			"import": "./dist/api/index.mjs",
			"default": "./dist/api/index.mjs"
		}
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.5",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.7",
		"postgres": "^3.4.9",
		"utils": "workspace:*",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"auth": "^1.7.5",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-seed": "^0.3.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
