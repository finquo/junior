{
	"name": "backend",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bunx auth generate --config src/services.ts --output src/db/schema/auth.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"exports": {
		"api": "./src/api/index.ts",
		"auth": "./src/auth/index.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.5",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.7",
		"pg": "^8.23.0",
		"utils": "workspace:*",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "^8.23.1",
		"auth": "^1.7.5",
		"drizzle-kit": "1.0.0-rc.4",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:"
	}
}
