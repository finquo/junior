{
	"name": "backend",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bunx auth@latest generate --config src/services.ts --output src/db/schema/auth.ts --yes",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"utils": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"@better-auth/drizzle-adapter": "1.7.5",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.7",
		"pg": "^8.23.0",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"@types/node": "catalog:",
		"drizzle-kit": "1.0.0-rc.4",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:"
	}
}
