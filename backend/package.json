{
	"name": "backend",
	"type": "module",
	"scripts": {
		"construct": "varlock codegen && tsdown",
		"build": "varlock codegen && tsdown",
		"check": "tsc --noEmit",
		"format": "biome format ./ --write",
		"dev": "bun run --env-file=../.env --hot src/index.ts --port 3000",
		"start": "varlock codegen && tsdown --watch",
		"env:generate": "varlock codegen",
		"auth:generate": "auth generate --config src/services.ts --output src/db/auth.test.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"varlock": {
		"loadPath": [
			"./",
			"../"
		]
	},
	"exports": {
		".": {
			"import": "./out/index.mjs",
			"types": "./out/index.d.mts",
			"default": "./out/index.mjs"
		},
		"./config": {
			"import": "./dist/config.mjs",
			"types": "./dist/config.d.mts",
			"default": "./dist/config.mjs"
		},
		"./auth": {
			"import": "./dist/auth.mjs",
			"types": "./dist/auth.d.mts",
			"default": "./dist/auth.mjs"
		},
		"./db": {
			"import": "./dist/db.mjs",
			"types": "./dist/db.d.mts",
			"default": "./dist/db.mjs"
		},
		"./api": {
			"types": "./dist/api.d.mts",
			"import": "./dist/api.mjs",
			"default": "./dist/api.mjs"
		}
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.110",
		"@aws-sdk/client-mediaconvert": "^3.1152.0",
		"@aws-sdk/client-s3": "^3.1154.0",
		"@aws-sdk/s3-request-presigner": "^3.1154.0",
		"@better-auth/drizzle-adapter": "1.7.5",
		"@better-fetch/fetch": "^1.3.3",
		"@chat-adapter/state-pg": "^4.43.0",
		"@chat-adapter/whatsapp": "^4.43.0",
		"@hono/aws-lambda": "^1.0.1",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"ai": "^7.0.143",
		"aws4fetch": "^1.0.20",
		"better-auth": "catalog:",
		"chat": "^4.43.0",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.13",
		"postgres": "^3.4.9",
		"unstorage": "^1.17.6",
		"utils": "workspace:*",
		"varlock": "catalog:",
		"vtt-to-json": "^0.1.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"auth": "^1.7.5",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-seed": "^0.3.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:"
	}
}
