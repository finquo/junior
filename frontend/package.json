{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 4000",
		"build": "varlock codegen && next build",
		"check": "tsc --noEmit",
		"start": "bun run --env-file=../.env .next/standalone/frontend/server.js",
		"env:generate": "varlock codegen",
		"dev:vinext": "varlock codegen && varlock run -- vite dev --port 4000",
		"build:vinext": "varlock codegen && varlock run -- vite build",
		"start:vinext": "varlock run -- vinext start"
	},
	"varlock": {
		"loadPath": [
			"./",
			"../"
		]
	},
	"dependencies": {
