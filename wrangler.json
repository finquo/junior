{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "junior",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "./frontend/server.ts",
	"observability": {
		"enabled": true
	},
	"build": {
		"command": "bun run compile",
		"watch_dir": ["backend", "frontend", "packages"]
	},
	"keep_vars": true,
	"vars": {
		"CORS_ORIGIN": "https://junior.finquo.workers.dev",
		"BETTER_AUTH_URL": "https://junior.finquo.workers.dev",
		"NODE_ENV": "production",
		"EXPORT": true,
		"BUN_VERSION": "1.2.15",
		"NEXT_TELEMETRY_DISABLED": 1
	},
	"assets": {
		"directory": "./frontend/.open-next/assets",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*", "/.well-known/*"]
	},
	"send_metrics": false
}
